{
  "name": "reveil-musical",
  "version": "0.1.0",
  "description": "TP Réveil musical — réveille chaque utilisateur avec un morceau choisi selon le jour et la météo, puis le prévient sur son canal préféré.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.test.json",
    "license:scan": "node scripts/license-scan.mjs"
  },
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
